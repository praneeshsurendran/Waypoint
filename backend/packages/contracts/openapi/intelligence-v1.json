            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ForecastResponse": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "data_as_of": {
            "type": "string",
            "format": "date",
            "title": "Data As Of"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ForecastRow"
            },
            "type": "array",
            "title": "Rows"
          },
          "backtest": {
            "$ref": "#/components/schemas/Backtest"
          }
        },
        "type": "object",
        "required": [
          "model_version",
          "method",
          "data_as_of",
          "rows",
          "backtest"
        ],
        "title": "ForecastResponse"
      },
      "ForecastRow": {
        "properties": {
          "row_id": {
            "type": "string",
            "title": "Row Id"
          },
          "depot": {
            "type": "string",
            "title": "Depot"
          },
          "brand": {
            "type": "string",
            "enum": [
              "Fresh",
              "Style",
              "Tech"
            ],
            "title": "Brand"
          },
          "iso_year": {
            "type": "integer",
            "title": "Iso Year"
          },
          "iso_week": {
            "type": "integer",
            "maximum": 53.0,
            "minimum": 1.0,
            "title": "Iso Week"
          },
          "total_m3": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total M3"
          },
          "chilled_m3": {
            "type": "number",
            "minimum": 0.0,
            "title": "Chilled M3"
          }
        },
        "type": "object",
        "required": [
          "row_id",
          "depot",
          "brand",
          "iso_year",
          "iso_week",
          "total_m3",
          "chilled_m3"
        ],
        "title": "ForecastRow"
      },
      "HttpErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "HttpErrorResponse"
      },
      "JsonValue": {},
      "PlannedDelivery": {
        "properties": {
          "delivery_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Delivery Id"
          },
          "route_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Route Id"
          },
          "seq_in_route": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seq In Route"
          },
          "dispatch_date": {
            "type": "string",
            "format": "date",
            "title": "Dispatch Date"
          },
          "outlet_id": {
            "type": "string",
            "title": "Outlet Id"
          },
          "vehicle_id": {
            "type": "string",
            "title": "Vehicle Id"
          },
          "temp_requirement": {
            "type": "string",
            "enum": [
              "ambient",
              "chilled",
              "frozen"
            ],
            "title": "Temp Requirement"
          },
          "order_units": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Order Units"
          },
          "order_weight_kg": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Order Weight Kg"
          },
          "order_volume_m3": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Order Volume M3"
          },
          "planned_depart_time": {
            "type": "string",
            "format": "time",
            "title": "Planned Depart Time"
          },
          "planned_arrival_time": {
            "type": "string",
            "format": "time",
            "title": "Planned Arrival Time"
          },
          "planned_travel_duration_min": {
            "type": "number",
            "minimum": 0.0,
            "title": "Planned Travel Duration Min"
          },
          "distance_km": {
            "type": "number",
            "minimum": 0.0,
            "title": "Distance Km"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "delivery_id",
          "route_id",
          "seq_in_route",
          "dispatch_date",
          "outlet_id",
          "vehicle_id",
          "temp_requirement",
          "order_units",
          "order_weight_kg",
          "order_volume_m3",
          "planned_depart_time",
          "planned_arrival_time",
          "planned_travel_duration_min",
          "distance_km"
        ],
        "title": "PlannedDelivery"
      },
      "PlannedPredictionRequest": {
        "properties": {
          "deliveries": {
            "items": {
              "$ref": "#/components/schemas/PlannedDelivery"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
