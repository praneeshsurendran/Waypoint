  "components": {
    "schemas": {
      "Backtest": {
        "properties": {
          "weeks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Weeks"
          },
          "wape_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wape Percent"
          },
          "by_depot": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "By Depot"
          }
        },
        "type": "object",
        "required": [
          "weeks",
          "wape_percent",
          "by_depot"
        ],
        "title": "Backtest"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
